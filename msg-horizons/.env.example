# Public site URL used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://msg-horizons.vercel.app

# --- Lead delivery (configure at least one, otherwise the form falls back to WhatsApp/email hand-off) ---
# Any HTTPS endpoint that accepts a JSON POST (Zapier, Make, n8n, Slack workflow, CRM webhook...)
LEAD_WEBHOOK_URL=
# Or send leads by email through Resend (https://resend.com)
RESEND_API_KEY=
LEAD_EMAIL_TO=info@msg-horizons.com
LEAD_EMAIL_FROM=MSG Horizons Website <leads@msg-horizons.com>

# Vercel Web Analytics + Speed Insights: enable both in the Vercel dashboard first, then set to 1
NEXT_PUBLIC_VERCEL_ANALYTICS=

# Optional Google Analytics 4 measurement ID (Vercel Web Analytics is always on)
NEXT_PUBLIC_GA_ID=

# Route console map (all optional). The console flies a real 3D map; without any of these it uses free,
# key-less defaults, and falls back to a flat map on its own if the map or routes cannot load.
# Street map style (free, with 3D buildings; attribution is shown on the map):
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Adds a "Satellite" button (MapTiler satellite imagery). Create a free key at maptiler.com and restrict it to your domain:
# NEXT_PUBLIC_MAPTILER_KEY=
# Road routing for the flyover. Pre-compute the common routes instead with scripts/build-routes.mjs:
# NEXT_PUBLIC_ROUTING_URL=https://router.project-osrm.org
# Set to 0 to always use the flat console map:
# NEXT_PUBLIC_REAL_MAP=1
